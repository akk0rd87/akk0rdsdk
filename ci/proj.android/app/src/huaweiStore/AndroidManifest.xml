<?xml version="1.0" encoding="utf-8"?>
<!-- Видимость AppGallery: окно отзыва и страница приложения открываются в com.huawei.appmarket -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <package android:name="com.huawei.appmarket" />
  </queries>
  <application>
    <!-- Покупки HMS IAP (framework/billing/huawei): шторка оплаты и вход в аккаунт Huawei отдают результат сюда -->
    <activity android:name="org.akkord.lib.HuaweiIapActivity"
              android:exported="false"
              android:theme="@android:style/Theme.Translucent.NoTitleBar"
              android:configChanges="orientation|screenSize|keyboardHidden" />
  </application>
</manifest>
